{
  "name": "sol-terminal",
  "version": "0.1.0",
  "private": true,
  "description": "Solana memecoin trading terminal: PumpPortal + DexScreener feeds, rug checks, PumpPortal/Jupiter execution, one-file HTML UI. Paper mode by default.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "record": "RECORD=1 tsx src/server.ts",
    "fixture": "tsx test/make-fixture.ts",
    "replay": "tsx test/replay.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^6.0.0",
    "dotenv": "^18.0.5",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
