# Copy to .env and fill in. Never commit .env.

# Paid RPC strongly recommended. The public endpoint rate-limits and drops transactions.
RPC_URL=https://your-rpc-provider/?api-key=XXXX

# Burner wallet only, small balance. Leave empty to run paper mode with no key at all.
WALLET_SECRET_B58=

# Needed for Jupiter quotes (also in paper mode once a token leaves the curve).
JUP_API_KEY=

PAPER=true
MAX_SOL_PER_TRADE=0.05
MAX_OPEN_POSITIONS=5
PORT=8787
